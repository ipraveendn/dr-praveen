generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String    @unique
  password  String
  role      String    @default("USER")
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @updatedAt @db.Timestamp(6)
}

model RefreshSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username  String
  role      String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamp(6)
  revokedAt DateTime? @db.Timestamp(6)
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @updatedAt @db.Timestamp(6)

  @@index([username, revokedAt, expiresAt], map: "idx_refresh_session_user_active")
}

model Clinic {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String        @unique
  address      String
  createdAt    DateTime?     @default(now()) @db.Timestamp(6)
  updatedAt    DateTime?     @default(now()) @updatedAt @db.Timestamp(6)
  tokens       Token[]
  appointments Appointment[]
}

model Patient {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  phone        String        @unique
  email        String?
  place        String?
  patientId    String?       @unique
  age          Int?
  gender       String?
  reason       String?
  clinicId     String?       @db.Uuid
  createdAt    DateTime?     @default(now()) @db.Timestamp(6)
  updatedAt    DateTime?     @default(now()) @updatedAt @db.Timestamp(6)
  clinicName   String?
  tokens       Token[]
  appointments Appointment[]

  @@index([phone], map: "idx_patient_phone")
}

model Token {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenNumber      Int
  status           TokenStatus @default(WAITING)
  reasonForVisit   String
  createdAt        DateTime?   @default(now()) @db.Timestamp(6)
  updatedAt        DateTime?   @default(now()) @updatedAt @db.Timestamp(6)
  clinicId         String      @db.Uuid
  patientId        String      @db.Uuid
  reason           String?
  appointmentDate  DateTime?   @db.Timestamp(6)
  consultationMode String?
  clinic           Clinic      @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient          Patient     @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tokenNumber, appointmentDate], map: "unique_daily_token")
  @@index([clinicId(sort: Desc), appointmentDate(sort: Desc)], map: "idx_token_clinic_appointmentdate")
  @@index([clinicId, status, appointmentDate, tokenNumber], map: "idx_token_queue_next")
}

enum TokenStatus {
  WAITING
  SERVING
  COMPLETED
  CANCELLED
}

model PharmacyRequest {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prescriptionPath String?   @map("prescription_path")
  customization    String?
  status           String    @default("Pending")
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("pharmacy_requests")
}

model Appointment {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId         String            @db.Uuid
  patientId        String            @db.Uuid
  appointmentDate  DateTime          @db.Date
  appointmentTime  String
  consultationMode String
  status           AppointmentStatus @default(CONFIRMED)
  paymentMethod    String?
  reason           String?
  notes            String?
  createdAt        DateTime?         @default(now()) @db.Timestamp(6)
  updatedAt        DateTime?         @default(now()) @updatedAt @db.Timestamp(6)
  cancelledAt      DateTime?         @db.Timestamp(6)

  clinic           Clinic            @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([clinicId, appointmentDate], map: "idx_appointment_clinic_date")
  @@index([patientId], map: "idx_appointment_patient")
  @@index([status], map: "idx_appointment_status")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

